# --- Web server (docker-compose env_file) ---
ADMIN_USER=admin
ADMIN_PASS=<strong-password>
ADMIN_PATH=/admin-secret-change-me
AGENT_URL=http://<AGENT_HOST>:3001
AGENT_TOKEN=<long-random-token-shared-with-agent>
# Optional overrides (defaults shown in docker-compose.yml):
# ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302"]}]
# MTX_URL=http://<MTX_HOST>:8889
# RTC_ENABLED=1
# SPECTATOR_URL=
# YOUTUBE_URL=
# YT_CHANNEL=https://www.youtube.com/@YOUR_CHANNEL
# Optional Pix donation box:
# PIX_ENABLED=0
# PIX_CODE=
# PIX_AMOUNT=
